// Build settings for the PawDone app target.
// Supabase and Google details come from Secrets.xcconfig, which isn't committed.
// Copy Secrets.example.xcconfig to Secrets.xcconfig and fill it in.

SUPABASE_HOST =
SUPABASE_ANON_KEY =

// Premium purchases are unavailable until these are set.
// Xcode builds use REVENUECAT_API_KEY; TestFlight and App Store builds use REVENUECAT_APP_STORE_KEY.
REVENUECAT_API_KEY =
REVENUECAT_APP_STORE_KEY =

// Google sign-in is hidden until these are set.
GOOGLE_IOS_CLIENT_ID =
GOOGLE_WEB_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID = pawdone-google-not-configured

#include? "Secrets.xcconfig"
