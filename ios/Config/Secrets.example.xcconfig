// Copy this file to Secrets.xcconfig (same folder) and fill in your values.

// Supabase dashboard → Project Settings → API.
// Host only, without https:// (xcconfig files treat // as the start of a comment).
SUPABASE_HOST = your-project-ref.supabase.co
// The public anon key. Never put the service role key in the app.
SUPABASE_ANON_KEY = your-anon-key

// RevenueCat → API keys → SDK API keys (public keys only; never the secret key).
// Xcode (debug) builds: the Test Store key (test_…).
REVENUECAT_API_KEY = test_your-test-store-key
// TestFlight and App Store builds: the App Store app's key (appl_…).
REVENUECAT_APP_STORE_KEY = appl_your-app-store-key

// Google Cloud Console → APIs & Services → Credentials (optional; hides Google sign-in if empty).
// iOS client ID, e.g. 1234-abc.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID = your-ios-client-id.apps.googleusercontent.com
// Web client ID, from the separate "Web application" client.
GOOGLE_WEB_CLIENT_ID = your-web-client-id.apps.googleusercontent.com
// The iOS client's "iOS URL scheme", e.g. com.googleusercontent.apps.1234-abc
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-ios-client-id
