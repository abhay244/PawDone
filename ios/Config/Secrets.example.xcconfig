// Copy this file to Secrets.xcconfig (same folder) and fill in your Supabase project's
// details from the Supabase dashboard → Project Settings → API.

// Host only, without https:// (xcconfig files treat // as the start of a comment).
SUPABASE_HOST = your-project-ref.supabase.co

// The public anon (publishable) key. Never put the service role key in the app.
SUPABASE_ANON_KEY = your-anon-key
